{
  "name": "app-oficios-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:css": "tailwindcss -i ./src/styles/tailwind.input.css -o ./src/tailwind.css --minify",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync:android": "pnpm cap sync android",
    "cap:open:android": "pnpm cap open android",
    "android:build": "pnpm build && pnpm cap sync android && cd android && gradlew assembleDebug",
    "android:build:unix": "pnpm build && pnpm cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:prod": "VITE_API_URL=https://oficios-web-back.onrender.com pnpm build",
    "cap:sync:android:prod": "VITE_API_URL=https://oficios-web-back.onrender.com pnpm cap sync android",
    "android:build:prod": "pnpm build:android:prod && pnpm cap:sync:android:prod && cd android && cmd.exe /c gradlew.bat clean assembleDebug",
    "android:install:wsl": "cd android && cp app/build/outputs/apk/debug/app-debug.apk /mnt/c/Users/Federico/Downloads/app-debug.apk && /mnt/c/Users/Federico/AppData/Local/Android/Sdk/platform-tools/adb.exe uninstall ar.casaclick.app || true && /mnt/c/Users/Federico/AppData/Local/Android/Sdk/platform-tools/adb.exe install 'C:\\Users\\Federico\\Downloads\\app-debug.apk'",
    "android:launch:wsl": "/mnt/c/Users/Federico/AppData/Local/Android/Sdk/platform-tools/adb.exe shell monkey -p ar.casaclick.app 1",
    "android:reinstall:prod": "pnpm android:build:prod && pnpm android:install:wsl && pnpm android:launch:wsl",
    "android:verify-api-url": "grep -Roh 'oficios-web-back.onrender.com\\|192\\.168\\.[0-9.]*\\|127\\.0\\.0\\.1\\|localhost:8000' dist/assets/*.js android/app/src/main/assets/public/assets/*.js | sort -u",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "6.3.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.1",
    "@capacitor/push-notifications": "^6.0.5",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/forms": "^0.5.10",
    "axion": "^0.1.0",
    "axios": "^1.9.0",
    "firebase": "^11.5.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.508.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@eslint/js": "^9.21.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
